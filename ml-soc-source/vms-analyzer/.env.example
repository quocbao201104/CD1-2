# Bien moi truong VM3 - copy thanh .env va dien gia tri that. KHONG commit .env.

# Che do an toan: true = chi DE XUAT block (khong SSH that). Doi false khi demo that.
DRY_RUN=true

# Duong dan whitelist IP/user hop le
WHITELIST_PATH=data/whitelist.json

# Du lieu baseline va artifact IsolationForest da huan luyen
BASELINE_PATH=data/baseline.json
MODEL_PATH=data/isolation_forest.joblib

# Gotify tu host chi truy cap qua WireGuard (de trong token neu chua cau hinh -> chi ghi incidents.md)
GOTIFY_URL=http://10.66.0.1:8080
GOTIFY_APP_TOKEN=
GOTIFY_MIN_RISK=60

# SSH action toi VM1 (chi dung khi DRY_RUN=false)
VM1_HOST=soc-responder@192.168.245.10
VM1_KEY=~/.ssh/soc_action_key

# Bang anh xa IP -> hostname (de correlation khop server giua cac nguon alert bao mat)
HOST_MAP_PATH=data/host_map.json
