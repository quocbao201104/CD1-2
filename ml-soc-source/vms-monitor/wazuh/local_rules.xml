<!-- /var/ossec/etc/rules/local_rules.xml tren VM2 -->
<group name="local,soc_demo,">

  <!-- 1. Brute force SSH: nhieu lan dang nhap that bai tu cung IP -->
  <rule id="100100" level="10" frequency="6" timeframe="120">
    <if_matched_sid>5710</if_matched_sid>
    <same_source_ip />
    <description>SOC: Brute force SSH tu cung mot IP</description>
    <mitre><id>T1110</id></mitre>
  </rule>

  <!-- 2. Dang nhap thanh cong sau brute force -->
  <rule id="100101" level="12">
    <if_sid>5715</if_sid>
    <if_matched_sid>100100</if_matched_sid>
    <same_source_ip />
    <description>SOC: Login SSH thanh cong sau brute force</description>
    <mitre><id>T1078</id></mitre>
  </rule>

  <!-- 3. Tao tai khoan trai phep -->
  <rule id="100102" level="10">
    <if_sid>5902</if_sid>
    <description>SOC: Tai khoan moi duoc tao</description>
    <mitre><id>T1136</id></mitre>
  </rule>

  <!-- 4. Thay doi file tai khoan he thong qua FIM -->
  <rule id="100103" level="10">
    <if_group>syscheck</if_group>
    <match>/etc/passwd</match>
    <description>SOC: File /etc/passwd bi thay doi</description>
    <mitre><id>T1136</id></mitre>
  </rule>

  <!-- 5. Them hoac sua SSH authorized_keys -->
  <rule id="100104" level="12">
    <if_group>syscheck</if_group>
    <match>authorized_keys</match>
    <description>SOC: SSH authorized_keys bi thay doi</description>
    <mitre><id>T1098.004</id></mitre>
  </rule>

  <!-- 6. Su dung sudo / lenh quyen cao bat thuong -->
  <rule id="100105" level="8">
    <if_group>audit</if_group>
    <match>root_cmd</match>
    <description>SOC: Lenh quyen cao duoc thuc thi</description>
    <mitre><id>T1548.003</id></mitre>
  </rule>

  <!-- 7. Nang muc rieng alert Suricata co dau hieu Nmap/port scan de CD2 forward -->
  <rule id="100106" level="10">
    <if_sid>86601</if_sid>
    <match type="pcre2">(?i)(ET SCAN|Nmap|port scan)</match>
    <description>SOC: Suricata Nmap/port scan detected</description>
    <mitre><id>T1046</id></mitre>
  </rule>

  <!-- 8. Web sensitive path probing tren Nginx -->
  <rule id="100200" level="8">
    <if_sid>31100</if_sid>
    <regex>/\.env|/\.git|/admin|/phpmyadmin|/wp-login\.php</regex>
    <description>WEB: Sensitive path probing on Nginx</description>
    <mitre><id>T1595</id></mitre>
  </rule>

  <!-- 9. Directory traversal / doc file he thong qua HTTP -->
  <rule id="100201" level="10">
    <if_sid>31100</if_sid>
    <url>\.\./|%2e%2e|/etc/passwd</url>
    <description>WEB: Directory traversal attempt on Nginx</description>
    <mitre><id>T1190</id></mitre>
  </rule>

  <!-- 10. Noi dung web root bi thay doi -->
  <rule id="100202" level="12">
    <if_group>syscheck</if_group>
    <match>/var/www/html</match>
    <description>SOC: Web root file modified</description>
    <mitre><id>T1491</id></mitre>
  </rule>

  <!-- 11. File dang ngo trong web root -->
  <rule id="100203" level="12">
    <if_sid>100202</if_sid>
    <match type="pcre2">/var/www/html/.*(shell|backdoor|payload|\.backdoor)</match>
    <description>SOC: Suspicious file created in web root</description>
    <mitre><id>T1505.003</id></mitre>
  </rule>

</group>
